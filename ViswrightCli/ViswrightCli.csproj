<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>viswright</AssemblyName>
    <RootNamespace>Viswright.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Precompiled when published: a compile step runs this once and exits, so every run would
         otherwise pay to JIT everything it touches. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viswright\Viswright.csproj" />
  </ItemGroup>

</Project>
